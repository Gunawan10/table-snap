{
  "manifest_version": 3,
  "name": "TableSnap",
  "version": "1.0.0",
  "description": "Export HTML tables as CSV, Markdown, or PNG in one click.",
  "permissions": ["storage", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TableSnap Settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/extension-state.js",
        "content/image-background-fix.js",
        "content/content-script.js",
        "content/card-copy-actions.js",
        "content/card-position-fix.js"
      ],
      "css": ["content/content.css", "content/save-loading.css"],
      "run_at": "document_idle"
    }
  ]
}
